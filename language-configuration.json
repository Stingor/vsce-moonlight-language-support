{
    "comments": {
        "lineComment": "//",
        "blockComment": [ "/*", "*/" ]
    },
    "brackets": [
        ["{", "}"],
        ["[", "]"],
        ["(", ")"]
    ],
    "autoClosingPairs": [
        ["{", "}"],
        ["[", "]"],
        ["(", ")"],
        { "open": "\"", "close": "\"", "notIn": ["string", "comment"] }
    ],
    "surroundingPairs": [
        ["{", "}"],
        ["[", "]"],
        ["(", ")"],
        ["\"", "\""]
    ],
    // Un mot est une variable entière, préfixe de portée et suffixe « $ » compris :
    // .@var$, $@var, ##var, 'var. Le double-clic et la recherche d'occurrences
    // prennent alors la variable, pas seulement son nom.
    "wordPattern": "(-?\\d+)|((\\.@|\\$@|##|[.$@#'])?[A-Za-z_][A-Za-z0-9_]*\\$?)",
    "folding": {
        "markers": {
            "start": "^\\s*//\\s*#?region\\b",
            "end": "^\\s*//\\s*#?endregion\\b"
        }
    },
    "indentationRules": {
        "increaseIndentPattern": "^.*\\{[^}\"']*$",
        "decreaseIndentPattern": "^\\s*\\}"
    }
}
