{
    "name": "moonlight-language-support",
    "displayName": "Moonlight Language Support",
    "description": "Adds syntax highlighting and code snippets for the moonlight Scripting Language",
    "publisher": "Stingor",
    "icon": "rathena-icon.avif",
    "repository": {
        "type": "git",
        "url": "https://github.com/Stingor/vsce-moonlight-language-support"
    },
    "author": {
        "name": "Moonlight"
    },
    "contributors": [
        {
            "name": "JoWei",
            "url": "https://github.com/JoWei"
        },
        {
            "name": "Jittapan Pleumsumran",
            "url": "https://github.com/secretdataz/athena-language-support"
        },
        {
            "name": "rAthena Developers",
            "url": "https://github.com/rathena/"
        }
    ],
    "license": "MIT",
    "private": true,
    "bugs": {
        "url": "https://github.com/Stingor/vsce-moonlight-language-support/issues"
    },
    "version": "1.5.0",
    "engines": {
        "vscode": "^1.120.0"
    },
    "categories": [
        "Programming Languages",
        "Snippets"
    ],
    "activationEvents": [
        "onLanguage:rathena",
        "onUri"
    ],
    "main": "./out/extension",
    "capabilities": {
        "untrustedWorkspaces": {
            "supported": "limited",
            "description": "Dans un espace de travail non fiable, le rechargement sur le serveur est refusé, et ses réglages ne se lisent pas depuis le dossier ouvert.",
            "restrictedConfigurations": [
                "rathena.reload.onSave",
                "rathena.reload.host",
                "rathena.reload.secret"
            ]
        }
    },
    "contributes": {
        "languages": [
            {
                "id": "rathena",
                "aliases": [
                    "rAthena",
                    "rathena"
                ],
                "extensions": [
                    ".rascript",
                    ".npc"
                ],
                "firstLine": "^//(===== (rAthena Script|Moonlight)|!rathena)",
                "configuration": "./language-configuration.json"
            }
        ],
        "commands": [
            {
                "command": "rathena.wrapWithColorCodes",
                "title": "Entourer d'un code couleur"
            },
            {
                "command": "rathena.reloadNpcFile",
                "title": "Recharger ce script sur le serveur",
                "category": "Moonlight",
                "icon": "$(refresh)"
            },
            {
                "command": "rathena.forgetReloadSecret",
                "title": "Oublier le secret du canal d'administration",
                "category": "Moonlight"
            }
        ],
        "menus": {
            "editor/context": [
                {
                    "when": "editorHasSelection && editorLangId == rathena",
                    "command": "rathena.wrapWithColorCodes",
                    "group": "1_modification"
                },
                {
                    "when": "editorLangId == rathena",
                    "command": "rathena.reloadNpcFile",
                    "group": "navigation"
                }
            ],
            "editor/title": [
                {
                    "when": "editorLangId == rathena",
                    "command": "rathena.reloadNpcFile",
                    "group": "navigation"
                }
            ]
        },
        "keybindings": [
            {
                "command": "rathena.reloadNpcFile",
                "key": "ctrl+alt+r",
                "when": "editorTextFocus && editorLangId == rathena"
            }
        ],
        "grammars": [
            {
                "language": "rathena",
                "scopeName": "source.rathena",
                "path": "./syntaxes/rathena.json"
            }
        ],
        "snippets": [
            {
                "language": "rathena",
                "path": "./snippets/rathena.json"
            }
        ],
        "configurationDefaults": {
            "[rathena]": {
                "files.encoding": "windows1252",
                "files.autoGuessEncoding": false
            }
        },
        "configuration": {
            "title": "Scripts Moonlight",
            "properties": {
                "rathena.renderColors": {
                    "type": "boolean",
                    "default": true,
                    "description": "Colorer le texte des chaînes selon leurs codes ^RRGGBB, jusqu'à la fin de la chaîne.",
                    "order": 1
                },
                "rathena.hideColorCodes": {
                    "type": "boolean",
                    "default": true,
                    "description": "Masquer les codes ^RRGGBB, sauf dans la chaîne où se trouve le curseur. Demande « Render Colors ».",
                    "order": 2
                },
                "rathena.showColorPicker": {
                    "type": "boolean",
                    "default": true,
                    "description": "Proposer le sélecteur de couleur sur les codes ^RRGGBB.",
                    "order": 3
                },
                "rathena.reopenInWindows1252": {
                    "type": "boolean",
                    "default": true,
                    "description": "Rouvrir en Windows 1252 un script reconnu par sa première ligne qui n'est pas de l'UTF-8 valide, avant qu'un enregistrement ne perde ses accents.",
                    "order": 4
                },
                "rathena.checkScripts": {
                    "type": "boolean",
                    "default": true,
                    "description": "Signaler pendant la frappe les accolades déséquilibrées, les étiquettes introuvables (goto, callsub), les « case » qu'un menu select ne peut pas choisir, et les objets ou monstres absents des tables que charge le serveur.",
                    "order": 5
                },
                "rathena.reload.onSave": {
                    "type": "boolean",
                    "default": false,
                    "description": "Recharger le script sur le serveur à chaque enregistrement, par le canal d'administration du map-server.",
                    "order": 10
                },
                "rathena.reload.host": {
                    "type": "string",
                    "scope": "machine",
                    "default": "127.0.0.1",
                    "description": "L'hôte du canal d'administration. Sous Remote-SSH, l'extension tourne sur la machine du serveur : 127.0.0.1 suffit.",
                    "order": 11
                },
                "rathena.reload.secret": {
                    "type": "string",
                    "scope": "machine",
                    "default": "",
                    "description": "Le secret du canal d'administration, en clair. Mieux vaut le laisser vide : celui de conf/admin.conf s'il y est en clair, sinon il est demandé une fois et gardé dans le coffre de secrets de VSCode.",
                    "order": 12
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "lint": "eslint \"src/**/*.ts\"",
        "watch": "tsc -watch -p ./",
        "generate": "node scripts/generate-grammar.js --server ../moonlight",
        "test": "tsc -p ./ && mocha"
    },
    "devDependencies": {
        "@types/mocha": "^10.0.10",
        "@types/node": "^16.18.126",
        "@types/vscode": "^1.120.0",
        "@typescript-eslint/eslint-plugin": "^5.59.2",
        "@typescript-eslint/parser": "^5.42.0",
        "eslint": "^8.39.0",
        "eslint-config-standard-with-typescript": "^34.0.1",
        "eslint-plugin-import": "^2.27.5",
        "eslint-plugin-n": "^15.7.0",
        "eslint-plugin-promise": "^6.1.1",
        "mocha": "^10.8.2",
        "typescript": "^5.0.4",
        "vscode-oniguruma": "^2.0.1",
        "vscode-textmate": "^9.3.2"
    }
}
